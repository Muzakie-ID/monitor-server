# Salin ke .env lalu ganti nilainya
POSTGRES_DB=pantau
POSTGRES_USER=pantau
POSTGRES_PASSWORD=ganti-password-ini

# Rahasia untuk menandatangani token login (minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-string-acak-panjang

# Akun admin pertama, dibuat otomatis saat backend pertama kali jalan
ADMIN_EMAIL=admin@contoh.local
ADMIN_PASSWORD=ganti-password-admin

# Token yang dipakai Alertmanager saat mengirim webhook ke backend
ALERT_WEBHOOK_TOKEN=ganti-token-webhook

HTTP_PORT=8080
