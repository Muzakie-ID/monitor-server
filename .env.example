# Salin ke .env lalu ganti nilainya
POSTGRES_DB=pantau
POSTGRES_USER=pantau
POSTGRES_PASSWORD=ganti-password-ini

# Rahasia untuk menandatangani token login (minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-string-acak-panjang

# Akun admin pertama, dibuat otomatis saat backend pertama kali jalan
ADMIN_EMAIL=admin@contoh.local
ADMIN_PASSWORD=ganti-password-admin

# Token yang dipakai Alertmanager saat mengirim webhook ke backend
ALERT_WEBHOOK_TOKEN=ganti-token-webhook

HTTP_PORT=8080

# Token rahasia antara backend dan provisioner (minimal 32 karakter acak)
PROVISIONER_TOKEN=ganti-dengan-string-acak-panjang-lain

# Alamat server pemantau ini yang bisa dijangkau dari server target (IP atau nama DNS).
# Wajib diisi kalau ingin memakai fitur "Kumpulkan log". Kosong = fitur log dimatikan.
MONITOR_PUBLIC_HOST=

# Port gateway log (TLS + basic auth). Buka port ini dari server target ke server pemantau.
LOKI_PORT=3101

# Opsional: IP server pemantau seperti terlihat dari server target, untuk aturan ufw.
# Kosong = dideteksi otomatis dari koneksi SSH.
MONITOR_SOURCE_IP=
